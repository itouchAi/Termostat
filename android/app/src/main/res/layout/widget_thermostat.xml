<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#1B1726"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- Sol Bölüm: Maskot & Durum -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖 TermoBot"
            android:textColor="#A78BFA"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_current_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="21.8°C"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 Kombi Yanıyor"
            android:textColor="#FF9800"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Orta Bölüm: Hedef ve Nem -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="12dp"
        android:gravity="end">

        <TextView
            android:id="@+id/tv_target_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hedef: 22.5°C"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_humidity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nem: %48"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Sağ Bölüm: Hızlı Sıcaklık Kontrol Butonları -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_temp_down"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="-"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="#2E283E"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_temp_up"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="+"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="#10B981" />
    </LinearLayout>
</LinearLayout>
